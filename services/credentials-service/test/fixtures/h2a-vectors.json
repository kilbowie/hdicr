    {
      "id": "02-unicode-subject-name",
      "why": "A performer whose name carries diacritics. RFC 8785 §3.2.2.2 emits characters above U+001F as literal UTF-8; Python's json.dumps defaults to ensure_ascii=True and escapes them, so the two disagree on a completely ordinary grant.",
      "catches": [
        "py-json-dumps"
      ],
      "input_json": "{\"subject_ref\":\"José Muñoz\",\"grant_id\":\"g-9f2c\"}\n",
      "canonical": "{\"grant_id\":\"g-9f2c\",\"subject_ref\":\"José Muñoz\"}",
