  "spec": "RFC 8785 JSON Canonicalization Scheme",
  "generated_from_rfc_appendix_b": true,
  "canonicalization_vectors": [
    {
      "id": "01-rfc8785-appendix-b",
      "why": "RFC 8785's own published test data. Anchors this file to the RFC rather than to any library. If an implementation fails only this vector, its number or escape handling is broken.",
