    {
      "id": "03-lease-cap-decimal",
      "why": "A lease cap authored as 500.0 rather than 500. ECMAScript Number::toString emits 500; Python's repr emits 500.0. Same number, different bytes, invalid signature.",
      "catches": [
        "py-json-dumps"
      ],
      "input_json": "{\"lease\":{\"cap\":500.0,\"currency\":\"GBP\",\"used\":0.0}}\n",
      "canonical": "{\"lease\":{\"cap\":500,\"currency\":\"GBP\",\"used\":0}}",
      "canonical_sha256": "4df63f07f4365b11a87fd8157a2ebb72f8e7e3e536f03be03c5994b01aed9909",
      "canonical_utf8_bytes": 47
    },
    {
      "id": "04-mixed-case-keys",
      "why": "Sorting must compare UTF-16 code units as unsigned integers (RFC 8785 §3.2.3: 'independent of locale settings'). localeCompare collates case-insensitively and puts 'alpha' before 'Beta'; JCS puts every uppercase key first.",
      "catches": [
        "ts-localecompare"
      ],
      "input_json": "{\"Zeta\":1,\"alpha\":2,\"Beta\":3,\"gamma\":4,\"ZETA\":5}\n",
      "canonical": "{\"Beta\":3,\"ZETA\":5,\"Zeta\":1,\"alpha\":2,\"gamma\":4}",
      "canonical_sha256": "9964b7dc58bebbcdaaaa5fb9ff5e57c45d7f18329d97f12b4d505424c4b2ed8d",
      "canonical_utf8_bytes": 48
    },
    {
      "id": "05-integer-like-keys",
      "why": "The subtlest of the four. A canonicaliser that sorts entries and then rebuilds a JavaScript object loses the sort: integer-like keys are re-ordered to the front in numeric order on insertion. JCS requires '10' < '2' by code unit. Emit from the sorted sequence, never via an object.",
      "catches": [
        "ts-localecompare"
      ],
      "input_json": "{\"10\":\"ten\",\"2\":\"two\",\"b\":\"bee\",\"1\":\"one\",\"02\":\"zero-two\"}\n",
      "canonical": "{\"02\":\"zero-two\",\"1\":\"one\",\"10\":\"ten\",\"2\":\"two\",\"b\":\"bee\"}",
      "canonical_sha256": "0215810db3410cb6bf4ff4da336ba71ce85a8eafbb075883150733f7488091ca",
      "canonical_utf8_bytes": 58
    },
    {
      "id": "06-nesting-null-empty",
      "why": "Structural regression guard: nested objects inside arrays must be sorted too, empty arrays and objects must survive, and null must not be confused with an object by a truthiness test.",
      "catches": [],
      "input_json": "{\"a\":{\"d\":[1,{\"z\":1,\"a\":2}],\"b\":null},\"c\":[],\"e\":{},\"f\":[[],[{}]]}\n",
      "canonical": "{\"a\":{\"b\":null,\"d\":[1,{\"a\":2,\"z\":1}]},\"c\":[],\"e\":{},\"f\":[[],[{}]]}",
      "canonical_sha256": "b6ce0a407b5913f8f0ce82af975d3c140ac90313ab32085fe721879428d6d795",
      "canonical_utf8_bytes": 66
    },
    {
      "id": "07-control-characters",
      "why": "RFC 8785 §3.2.2.2: U+0000-U+001F use lowercase \\uhhhh except the five with short forms (\\b \\t \\n \\f \\r). Only quote and backslash are escaped above that range.",
      "catches": [],
      "input_json": "{\"tab_newline\":\"tab\\there\\nnewline\",\"bare_control\":\"\\u0001\",\"nul\":\"\\u0000\",\"quote_backslash\":\"\\\" and \\\\\",\"short_forms\":\"\\b\\f\\r\",\"boundary\":\"\\u001f \"}\n",
      "canonical": "{\"bare_control\":\"\\u0001\",\"boundary\":\"\\u001f \",\"nul\":\"\\u0000\",\"quote_backslash\":\"\\\" and \\\\\",\"short_forms\":\"\\b\\f\\r\",\"tab_newline\":\"tab\\there\\nnewline\"}",
      "canonical_sha256": "dffa1acc60633c6fdc60c0cf3a70c4c50a41f749a5bcb5678eee47c595967515",
      "canonical_utf8_bytes": 149
    },
    {
      "id": "08-number-forms",
      "why": "Number serialisation across the awkward range: integral floats, negative zero (JCS emits 0, Python emits -0.0), exponent thresholds, and the largest integer that survives a double.",
