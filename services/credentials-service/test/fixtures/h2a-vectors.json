      "input_json": "{\n  \"h2a\": \"0.1\",\n  \"grant_id\": \"urn:uuid:0f9b1e3a-5c47-4a1e-9d0b-2c8f4a6b1d23\",\n  \"iss\": \"https://issuer.example.org/h2a/issuer\",\n  \"subject_ref\": \"did:example:José-Muñoz\",\n  \"grantee_ref\": \"urn:example:operator:acme\",\n  \"nbf\": \"2026-08-06T00:00:00Z\",\n  \"exp\": \"2027-08-06T00:00:00Z\",\n  \"Use\": [\"advertising\"],\n  \"use\": [\"advertising\", \"editorial\"],\n  \"territory\": [\"GLOBAL\"],\n  \"lease\": {\"cap\": 500.0, \"currency\": \"GBP\"},\n  \"exclusions\": [],\n  \"status\": {\"type\": \"BitstringStatusListEntry\", \"index\": 1024,\n             \"uri\": \"https://issuer.example.org/h2a/status/1\"}\n}\n",
