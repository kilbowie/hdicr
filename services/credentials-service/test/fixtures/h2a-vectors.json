      "canonical": "{\"a\":100,\"b\":0.1,\"c\":0,\"d\":1e+21,\"e\":1e-7,\"f\":9007199254740991,\"g\":-1.5}",
      "canonical_sha256": "f58726e901054308904e0ff966d43de864e9f069fb7ac20398900197dcec4b55",
      "canonical_utf8_bytes": 72
    },
    {
      "id": "09-grant-signing-preimage",
      "why": "ADR-014 §3. The preimage for a detached grant signature is the grant with the `signatures` member REMOVED, not emptied. This vector is that preimage; every signer in the estate must derive these exact bytes before signing.",
